# General
TZ=Europe/Madrid

# Shared Docker network
MUSIC_NETWORK=music-network

# Host ports (Pi-hole keeps port 80)
NGINX_HTTP_PORT=8084
NGINX_HTTPS_PORT=8444
NGINX_ADMIN_PORT=8181

# Persistent data
NGINX_DATA_PATH=/home/villacus/nginx/data
NGINX_LETSENCRYPT_PATH=/home/villacus/nginx/letsencrypt
