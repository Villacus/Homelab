# General
TZ=Europe/Madrid
MUSIC_NETWORK=music-network
PUID=1000
PGID=1000

# Metadata catalog (user can also switch in the web UI)
# Default: deezer (free, no API key) or spotify (requires credentials below)
DEFAULT_METADATA_PROVIDER=deezer

# Ports and persistent paths
MUSIKAT_PORT=8010
MUSIKAT_DOWNLOADS_PATH=/home/villacus/musikat/downloads

# Host music folders shared with Navidrome. Musikat mounts these as /music/*.
MUSIKAT_MUSIC_PATH=/mnt/nasdisk/privada/Musica
MUSIKAT_ITZIAR_MUSIC_PATH=/mnt/nasdisk/compartida/Musica
MUSIKAT_JONPA_MUSIC_PATH=/mnt/nasdisk/privada/Musica_jon

# Spotify (optional — only if you use catalog "spotify")
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://localhost:8000/callback

# Navidrome Configuration
# Container paths used by Musikat; each path is shown as a download destination.
NAVIDROME_MUSIC_PATH=/music/jonpa
NAVIDROME_MUSIC_PATHS=/music/main,/music/itziar,/music/jonpa
NAVIDROME_MUSIC_LABELS=Musica,Itziar,Jonpa
# Navidrome is reachable by service name on the shared Docker network.
NAVIDROME_API_URL=http://navidrome:4533
# Set NAVIDROME_USERNAME and NAVIDROME_PASSWORD as Arcane secrets/environment variables before deploying.
# NAVIDROME_USERNAME=
# NAVIDROME_PASSWORD=
# Background sync is opt-in and requires valid Navidrome credentials.
NAVIDROME_SYNC_ENABLED=false
NAVIDROME_SYNC_INTERVAL_HOURS=4
NAVIDROME_SYNC_INITIAL_DELAY_SEC=120
NAVIDROME_SYNC_API_DELAY_SEC=0.12

# Download Configuration
# Temporary files; completed Navidrome downloads are written below the selected music root.
DOWNLOAD_DIR=/app/downloads
OUTPUT_FORMAT=mp3
AUDIO_QUALITY=128
# Delay before deleting browser temp files (seconds); avoids 404 on duplicate GETs
# TEMP_FILE_CLEANUP_DELAY_SEC=60

# YouTube Configuration
# Optional: Path to YouTube cookies file (Netscape format) for bypassing bot detection
# Export cookies using browser extension or yt-dlp --cookies-from-browser
# See: https://github.com/yt-dlp/yt-dlp/wiki/FAQ#how-do-i-pass-cookies-to-yt-dlp
# YOUTUBE_COOKIES_PATH=/path/to/youtube_cookies.txt

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=https://musikat.tailf45616.ts.net,http://localhost:8010,http://127.0.0.1:8010,http://192.168.0.9:8010
